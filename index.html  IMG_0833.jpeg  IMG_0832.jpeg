<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>For Diya ❤️ | A Little Birthday Story</title>

<style>

/* =========================================================
   GOOGLE FONTS
========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Dancing+Script:wght@500;600;700&family=Montserrat:wght@300;400;500;600&display=swap');


/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Montserrat', sans-serif;
    background: #050308;
    color: white;
    overflow-x: hidden;
}


/* =========================================================
   CINEMATIC OVERLAY
========================================================= */

body::before {
    content: "";
    position: fixed;
    inset: 0;

    background:
        radial-gradient(
            circle at 50% 30%,
            rgba(255, 91, 160, 0.12),
            transparent 35%
        ),
        radial-gradient(
            circle at 20% 80%,
            rgba(128, 70, 255, 0.10),
            transparent 35%
        ),
        radial-gradient(
            circle at 80% 80%,
            rgba(255, 170, 80, 0.08),
            transparent 35%
        );

    pointer-events: none;
    z-index: 0;
}


/* =========================================================
   FILM GRAIN
========================================================= */

.grain {
    position: fixed;
    inset: 0;

    pointer-events: none;

    opacity: 0.08;

    z-index: 999;

    background-image:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");

    mix-blend-mode: screen;
}


/* =========================================================
   CINEMATIC LETTERBOX
========================================================= */

.letterbox-top,
.letterbox-bottom {
    position: fixed;

    left: 0;
    width: 100%;

    height: 5vh;

    background: #000;

    z-index: 1000;

    pointer-events: none;
}

.letterbox-top {
    top: 0;
}

.letterbox-bottom {
    bottom: 0;
}


/* =========================================================
   STARS
========================================================= */

.stars {
    position: fixed;
    inset: 0;

    pointer-events: none;

    z-index: 1;
}

.star {
    position: absolute;

    width: 2px;
    height: 2px;

    background: white;

    border-radius: 50%;

    opacity: 0.5;

    animation:
        twinkle 3s infinite alternate;
}

@keyframes twinkle {

    from {
        opacity: 0.15;
        transform: scale(0.7);
    }

    to {
        opacity: 1;
        transform: scale(1.5);
    }

}


/* =========================================================
   PARTICLES
========================================================= */

.particles {
    position: fixed;
    inset: 0;

    pointer-events: none;

    z-index: 2;
}

.particle {
    position: absolute;

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: #ffb5d5;

    opacity: 0.5;

    animation: particleFloat linear infinite;
}

@keyframes particleFloat {

    0% {
        transform:
            translateY(110vh)
            translateX(0)
            scale(0);
        opacity: 0;
    }

    15% {
        opacity: 0.8;
    }

    85% {
        opacity: 0.8;
    }

    100% {
        transform:
            translateY(-20vh)
            translateX(80px)
            scale(1);
        opacity: 0;
    }

}


/* =========================================================
   INTRO SCREEN
========================================================= */

.intro {

    position: fixed;

    inset: 0;

    background:
        radial-gradient(
            circle at center,
            #24101f,
            #080409 60%,
            #000
        );

    display: flex;

    align-items: center;
    justify-content: center;

    text-align: center;

    z-index: 2000;

    transition:
        opacity 1.5s ease,
        visibility 1.5s ease;
}

.intro.hidden {

    opacity: 0;

    visibility: hidden;

    pointer-events: none;
}

.intro-content {

    width: min(850px, 90%);

    animation: introAppear 2s ease;
}

@keyframes introAppear {

    from {
        opacity: 0;
        transform:
            translateY(40px)
            scale(0.95);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }

}

.intro-small {

    font-family: 'Cinzel', serif;

    font-size: 12px;

    letter-spacing: 7px;

    color: #cba9bb;

    margin-bottom: 25px;
}

.intro h1 {

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(70px, 16vw, 150px);

    color: #ffd0e2;

    text-shadow:
        0 0 20px rgba(255, 110, 170, 0.6),
        0 0 70px rgba(255, 70, 150, 0.25);

    margin-bottom: 20px;
}

.intro-subtitle {

    color: #d8c8d0;

    line-height: 1.9;

    max-width: 600px;

    margin: auto;

    font-size: 15px;
}

.begin-btn {

    margin-top: 40px;

    padding: 17px 42px;

    border-radius: 100px;

    border: 1px solid rgba(255,255,255,0.25);

    background:
        linear-gradient(
            135deg,
            #ff9bc5,
            #d88cff
        );

    color: #210916;

    font-family: 'Montserrat', sans-serif;

    font-weight: 600;

    letter-spacing: 1px;

    cursor: pointer;

    box-shadow:
        0 0 30px rgba(255,100,170,0.25);

    transition: 0.4s;
}

.begin-btn:hover {

    transform: scale(1.08);

    box-shadow:
        0 0 50px rgba(255,100,170,0.5);
}

.intro-note {

    margin-top: 20px;

    font-size: 11px;

    color: #806e78;
}


/* =========================================================
   MUSIC CONTROL
========================================================= */

.music-control {

    position: fixed;

    top: 45px;
    right: 25px;

    z-index: 1500;

    width: 48px;
    height: 48px;

    border-radius: 50%;

    border:
        1px solid rgba(255,255,255,0.2);

    background:
        rgba(20,10,20,0.65);

    backdrop-filter: blur(12px);

    color: white;

    cursor: pointer;

    font-size: 18px;

    display: flex;

    align-items: center;
    justify-content: center;

    transition: 0.3s;
}

.music-control:hover {

    transform: scale(1.1);

    border-color: #ff9fc7;
}


/* =========================================================
   SECTIONS
========================================================= */

section {

    position: relative;

    min-height: 100vh;

    padding:
        100px
        20px;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    z-index: 5;
}


/* =========================================================
   HERO
========================================================= */

.hero {

    flex-direction: column;

    min-height: 100vh;

    background:
        radial-gradient(
            ellipse at center,
            rgba(255,90,150,0.08),
            transparent 60%
        );
}

.hero-date {

    font-family: 'Cinzel', serif;

    font-size: 13px;

    letter-spacing: 6px;

    color: #d6aabd;

    margin-bottom: 25px;
}

.hero h1 {

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(80px, 18vw, 180px);

    color: #ffd0e0;

    line-height: 0.9;

    text-shadow:
        0 0 15px rgba(255,130,180,0.55),
        0 0 60px rgba(255,70,160,0.3);

    animation:
        cinematicGlow 4s infinite alternate;
}

@keyframes cinematicGlow {

    from {
        filter: brightness(0.9);
    }

    to {
        filter: brightness(1.2);
    }

}

.hero-line {

    width: 120px;

    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            #ff9fc7,
            transparent
        );

    margin: 35px auto;
}

.hero-message {

    max-width: 700px;

    color: #d8cbd2;

    line-height: 2;

    font-size: 16px;
}

.scroll-indicator {

    margin-top: 60px;

    font-size: 11px;

    letter-spacing: 4px;

    color: #8f7b87;

    animation:
        scrollBounce 2s infinite;
}

@keyframes scrollBounce {

    50% {
        transform: translateY(10px);
    }

}


/* =========================================================
   COUNTDOWN
========================================================= */

.countdown-section {

    flex-direction: column;

    background:
        radial-gradient(
            circle at center,
            rgba(255,100,170,0.07),
            transparent 55%
        );
}

.eyebrow {

    font-family: 'Cinzel', serif;

    font-size: 12px;

    letter-spacing: 5px;

    color: #c89bad;

    margin-bottom: 20px;
}

.countdown-title {

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(50px, 10vw, 90px);

    color: #ffc4d9;

    margin-bottom: 40px;
}

.countdown {

    display: grid;

    grid-template-columns:
        repeat(4, minmax(70px, 150px));

    gap: 15px;

    width: min(700px, 95%);
}

.time-box {

    padding: 25px 10px;

    border:
        1px solid rgba(255,255,255,0.1);

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.07),
            rgba(255,255,255,0.025)
        );

    backdrop-filter: blur(15px);

    box-shadow:
        0 20px 60px rgba(0,0,0,0.3);
}

.time-box strong {

    display: block;

    font-family: 'Cinzel', serif;

    font-size:
        clamp(30px, 7vw, 55px);

    font-weight: 500;

    color: #ffd4e2;
}

.time-box span {

    display: block;

    margin-top: 8px;

    font-size: 9px;

    letter-spacing: 3px;

    color: #9f8b96;
}

.countdown-note {

    margin-top: 35px;

    color: #bcaab3;

    font-size: 13px;
}


/* =========================================================
   MESSAGE CARD
========================================================= */

.message-section {

    background:
        linear-gradient(
            180deg,
            transparent,
            rgba(255,100,160,0.05),
            transparent
        );
}

.message-card {

    width: min(850px, 95%);

    padding: 60px 40px;

    border-radius: 35px;

    border:
        1px solid rgba(255,255,255,0.11);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.065),
            rgba(255,255,255,0.025)
        );

    backdrop-filter: blur(20px);

    box-shadow:
        0 30px 100px rgba(0,0,0,0.4);
}

.message-card h2 {

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(45px, 8vw, 70px);

    color: #ffc1d8;

    margin-bottom: 30px;
}

.message-card p {

    color: #d9ccd3;

    line-height: 2;

    font-size: 15px;
}

.typing {

    margin-top: 45px;

    min-height: 80px;

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(25px, 5vw, 36px);

    color: #ffb9d4;

    text-shadow:
        0 0 20px rgba(255,120,180,0.25);
}

.cursor {

    display: inline-block;

    width: 2px;

    height: 35px;

    background: #ff9fc7;

    margin-left: 5px;

    animation:
        blink 0.8s infinite;
}

@keyframes blink {

    50% {
        opacity: 0;
    }

}


/* =========================================================
   REASONS
========================================================= */

.reasons {

    flex-direction: column;
}

.section-title {

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(45px, 8vw, 70px);

    color: #ffc2d8;

    margin-bottom: 50px;
}

.reason-grid {

    width: min(1050px, 95%);

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}

.reason {

    padding: 35px 25px;

    border-radius: 25px;

    background:
        rgba(255,255,255,0.04);

    border:
        1px solid rgba(255,255,255,0.08);

    transition:
        0.5s;

    position: relative;

    overflow: hidden;
}

.reason::before {

    content: "";

    position: absolute;

    width: 150px;
    height: 150px;

    border-radius: 50%;

    background:
        rgba(255,100,170,0.06);

    filter: blur(30px);

    top: -60px;
    right: -60px;
}

.reason:hover {

    transform:
        translateY(-10px)
        scale(1.02);

    border-color:
        rgba(255,160,200,0.2);

    box-shadow:
        0 20px 60px rgba(0,0,0,0.3);
}

.reason-icon {

    font-size: 35px;

    margin-bottom: 18px;
}

.reason h3 {

    color: #ffc5da;

    font-family: 'Cinzel', serif;

    font-size: 14px;

    margin-bottom: 12px;
}

.reason p {

    color: #bfb1b9;

    font-size: 13px;

    line-height: 1.8;
}


/* =========================================================
   CINEMATIC GALLERY
========================================================= */

.gallery {

    flex-direction: column;
}

.gallery-subtitle {

    margin-top: -30px;

    margin-bottom: 45px;

    color: #95838d;

    font-size: 12px;

    letter-spacing: 2px;
}

.gallery-grid {

    width: min(1050px, 95%);

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 30px;
}

.photo-card {

    position: relative;

    overflow: hidden;

    border-radius: 30px;

    border:
        1px solid rgba(255,255,255,0.12);

    background: #120a12;

    box-shadow:
        0 30px 80px rgba(0,0,0,0.5);

    transform:
        translateY(0);

    transition:
        transform 0.6s;
}

.photo-card:hover {

    transform:
        translateY(-12px);
}

.photo-card img {

    width: 100%;

    height: 620px;

    object-fit: cover;

    display: block;

    transition:
        transform 1.2s ease;

    filter:
        saturate(0.95)
        contrast(1.05);
}

.photo-card:hover img {

    transform:
        scale(1.08);
}

.photo-overlay {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            to top,
            rgba(0,0,0,0.9),
            transparent 45%,
            rgba(0,0,0,0.05)
        );
}

.photo-caption {

    position: absolute;

    bottom: 0;

    left: 0;
    right: 0;

    padding: 45px 25px 25px;

    text-align: left;
}

.photo-caption h3 {

    font-family: 'Dancing Script', cursive;

    font-size: 38px;

    color: #ffd0e1;
}

.photo-caption p {

    margin-top: 5px;

    font-size: 12px;

    color: #d5cbd0;
}


/* =========================================================
   CINEMATIC QUOTE
========================================================= */

.quote-section {

    min-height: 80vh;

    background:
        radial-gradient(
            circle at center,
            rgba(255,100,170,0.08),
            transparent 60%
        );
}

.quote {

    width: min(900px, 90%);

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(35px, 6vw, 65px);

    line-height: 1.5;

    color: #f5dce6;

    text-shadow:
        0 0 30px rgba(255,120,180,0.2);
}

.quote span {

    color: #ff9fc7;
}


/* =========================================================
   TIMELINE
========================================================= */

.memory {

    flex-direction: column;
}

.timeline {

    width: min(800px, 95%);

    text-align: left;

    position: relative;
}

.timeline::before {

    content: "";

    position: absolute;

    left: 10px;

    top: 0;
    bottom: 0;

    width: 1px;

    background:
        linear-gradient(
            #ff9fc7,
            transparent
        );
}

.memory-item {

    position: relative;

    margin:
        35px
        0
        35px
        35px;

    padding: 28px;

    border-radius:
        0
        25px
        25px
        0;

    border:
        1px solid rgba(255,255,255,0.08);

    background:
        rgba(255,255,255,0.035);
}

.memory-item::before {

    content: "❤";

    position: absolute;

    left: -43px;

    top: 25px;

    color: #ff9fc7;

    font-size: 16px;
}

.memory-item h3 {

    font-family: 'Dancing Script', cursive;

    font-size: 30px;

    color: #ffc0d7;
}

.memory-item p {

    margin-top: 10px;

    color: #c4b6be;

    line-height: 1.9;

    font-size: 13px;
}


/* =========================================================
   BIRTHDAY REVEAL
========================================================= */

.birthday {

    flex-direction: column;

    overflow: hidden;

    background:
        radial-gradient(
            circle at center,
            rgba(255,90,150,0.14),
            transparent 60%
        );
}

.birthday-glow {

    position: absolute;

    width: 500px;
    height: 500px;

    border-radius: 50%;

    background:
        rgba(255,100,170,0.08);

    filter: blur(80px);

    animation:
        breathe 4s infinite alternate;
}

@keyframes breathe {

    from {
        transform: scale(0.8);
    }

    to {
        transform: scale(1.2);
    }

}

.birthday-content {

    position: relative;

    z-index: 4;
}

.birthday-small {

    font-family: 'Cinzel', serif;

    letter-spacing: 7px;

    font-size: 12px;

    color: #c9a4b4;

    margin-bottom: 20px;
}

.birthday h2 {

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(65px, 13vw, 130px);

    line-height: 1;

    color: #ffd0e2;

    text-shadow:
        0 0 30px rgba(255,110,170,0.65),
        0 0 80px rgba(255,70,150,0.25);
}

.birthday-date {

    font-family: 'Cinzel', serif;

    margin-top: 30px;

    font-size: 13px;

    letter-spacing: 5px;

    color: #dcb6c6;
}

.cake {

    font-size: 80px;

    margin:
        35px
        0;

    animation:
        cakeFloat 3s infinite ease-in-out;
}

@keyframes cakeFloat {

    50% {
        transform:
            translateY(-12px)
            rotate(2deg);
    }

}

.birthday-message {

    max-width: 650px;

    margin: auto;

    color: #d8cad2;

    line-height: 2;

    font-size: 15px;
}


/* =========================================================
   FINAL
========================================================= */

.final {

    flex-direction: column;

    min-height: 100vh;

    background:
        linear-gradient(
            180deg,
            transparent,
            rgba(255,80,150,0.08)
        );
}

.final-small {

    font-family: 'Cinzel', serif;

    letter-spacing: 5px;

    color: #aa8c9b;

    font-size: 11px;

    margin-bottom: 25px;
}

.final h2 {

    font-family: 'Dancing Script', cursive;

    font-size:
        clamp(55px, 10vw, 100px);

    color: #ffd0e0;

    line-height: 1.1;
}

.final p {

    width: min(650px, 90%);

    margin:
        30px
        auto;

    color: #cfc1c9;

    line-height: 2;
}

.final-heart {

    font-size: 50px;

    animation:
        heartBeat 1.5s infinite;
}

@keyframes heartBeat {

    0%, 100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.2);
    }
}


/* =========================================================
   APOLOGY / RESPECT
========================================================= */

.apology {

    min-height: 70vh;
}

.apology-card {

    width: min(750px, 95%);

    padding: 55px 35px;

    border-radius: 35px;

    background:
        rgba(255,255,255,0.035);

    border:
        1px solid rgba(255,255,255,0.08);
}

.apology-card .emoji {

    font-size: 40px;

    margin-bottom: 20px;
}

.apology-card h2 {

    font-family: 'Dancing Script', cursive;

    color: #ffc2d8;

    font-size: 50px;
}

.apology-card p {

    margin-top: 20px;

    color: #c9bbc3;

    line-height: 2;

    font-size: 14px;
}


/* =========================================================
   FOOTER
========================================================= */

footer {

    padding:
        40px
        20px
        80px;

    text-align: center;

    color: #655762;

    font-size: 11px;

    letter-spacing: 1px;
}

footer span {

    color: #ff9fc7;
}


/* =========================================================
   FLOATING HEARTS
========================================================= */

.heart {

    position: fixed;

    bottom: -40px;

    pointer-events: none;

    z-index: 20;

    animation:
        floatHeart linear forwards;
}

@keyframes floatHeart {

    0% {

        transform:
            translateY(0)
            rotate(0deg)
            scale(0.7);

        opacity: 0;
    }

    15% {
        opacity: 1;
    }

    100% {

        transform:
            translateY(-115vh)
            rotate(360deg)
            scale(1.2);

        opacity: 0;
    }
}


/* =========================================================
   PETALS
========================================================= */

.petal {

    position: fixed;

    top: -30px;

    pointer-events: none;

    z-index: 15;

    animation:
        petalFall linear forwards;

    opacity: 0.8;
}

@keyframes petalFall {

    0% {

        transform:
            translateY(-20px)
            rotate(0deg);

        opacity: 0;
    }

    15% {
        opacity: 0.9;
    }

    100% {

        transform:
            translateY(110vh)
            translateX(120px)
            rotate(500deg);

        opacity: 0;
    }
}


/* =========================================================
   CELEBRATION
========================================================= */

.confetti {

    position: fixed;

    width: 8px;
    height: 15px;

    z-index: 3000;

    pointer-events: none;

    animation:
        confettiFall 4s linear forwards;
}

@keyframes confettiFall {

    0% {

        transform:
            translateY(-20px)
            rotate(0deg);

        opacity: 1;
    }

    100% {

        transform:
            translateY(110vh)
            rotate(720deg);

        opacity: 0;
    }
}


/* =========================================================
   BUTTON
========================================================= */

.magic-button {

    margin-top: 30px;

    padding:
        15px
        35px;

    border-radius: 100px;

    background:
        transparent;

    border:
        1px solid #ff9fc7;

    color: #ffb9d3;

    cursor: pointer;

    font-family: 'Montserrat', sans-serif;

    transition: 0.3s;
}

.magic-button:hover {

    background:
        rgba(255,130,180,0.1);

    transform: scale(1.05);
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 800px) {

    .reason-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }

}

@media (max-width: 600px) {

    .letterbox-top,
    .letterbox-bottom {

        height: 3vh;
    }

    section {

        padding:
            90px
            15px;
    }

    .countdown {

        grid-template-columns:
            repeat(2, 1fr);
    }

    .gallery-grid {

        grid-template-columns: 1fr;
    }

    .photo-card img {

        height: 560px;
    }

    .reason-grid {

        grid-template-columns: 1fr;
    }

    .message-card {

        padding:
            45px
            22px;
    }

    .music-control {

        top: 30px;
        right: 15px;
    }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    * {

        animation-duration: 0.01ms !important;

        animation-iteration-count: 1 !important;

        scroll-behavior: auto !important;
    }

}

</style>

</head>


<body>


<!-- =======================================================
     CINEMATIC OVERLAYS
======================================================= -->

<div class="grain"></div>

<div class="letterbox-top"></div>
<div class="letterbox-bottom"></div>

<div class="stars" id="stars"></div>

<div class="particles" id="particles"></div>


<!-- =======================================================
     INTRO SCREEN
======================================================= -->

<div class="intro" id="intro">

    <div class="intro-content">

        <div class="intro-small">
            A CINEMATIC LITTLE SURPRISE
        </div>

        <h1>For Diya ❤️</h1>

        <div class="intro-subtitle">

            Tonight isn't just another night.

            <br><br>

            Somewhere between memories,
            random conversations,
            laughter and all the little moments...

            <br>

            someone became very special.

        </div>


        <button
            class="begin-btn"
            onclick="beginExperience()">

            🎬 Begin The Experience

        </button>

        <div class="intro-note">
            🎵 Tap once to begin the music
        </div>

    </div>

</div>


<!-- =======================================================
     MUSIC BUTTON
======================================================= -->

