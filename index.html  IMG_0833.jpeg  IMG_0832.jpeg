            <p>
                Somewhere along the way,
                ordinary days started becoming
                memories that actually mattered.
            </p>

        </div>


        <div class="memory-item">

            <h3>
                And Now...
            </h3>

            <p>
                I just hope there are still
                countless chapters left
                for us to write.
            </p>

        </div>


    </div>

</section>


<!-- =======================================================
     BIRTHDAY REVEAL
======================================================= -->

<section class="birthday">

    <div class="birthday-glow"></div>


    <div class="birthday-content">

        <div class="birthday-small">
            AND FINALLY...
        </div>


        <h2>
            Happy Birthday
        </h2>


        <div class="birthday-date">
            08 • SEPTEMBER • 2026
        </div>


        <div class="cake">
            🎂
        </div>


        <p class="birthday-message">

            Today is about celebrating you.

            <br><br>

            I hope this new year of your life
            brings you the kind of happiness
            that stays.

            The kind of smile that comes naturally.

            The kind of people who choose you,
            respect you,
            understand you
            and stay.

            <br><br>

            And I hope when you look back
            at this birthday someday...

            you remember that someone,
            somewhere,
            genuinely wished the very best for you.

        </p>


        <button
            class="magic-button"
            onclick="birthdayCelebration()">

            ✨ Make A Wish

        </button>

    </div>

</section>


<!-- =======================================================
     FINAL FRIENDSHIP MESSAGE
======================================================= -->

<section class="final">

    <div class="final-small">
        ONE LAST THING
    </div>


    <h2>
        Will you always<br>
        be my best friend? ❤️
    </h2>


    <p>

        No matter where life takes us,

        I hope we never become strangers.

        <br><br>

        I hope there will always be
        a little place in both our lives
        for this friendship.

        <br><br>

        And whatever happens,
        I will always be grateful
        that our paths crossed.

    </p>


    <div class="final-heart">
        ❤️
    </div>


    <button
        class="magic-button"
        onclick="birthdayCelebration()">

        Always ❤️

    </button>

</section>


<!-- =======================================================
     RESPECT / APOLOGY
======================================================= -->

<section class="apology">

    <div class="apology-card">

        <div class="emoji">
            🙏❤️
        </div>


        <h2>
            And One Last Thing...
        </h2>


        <p>

            If anything written here ever makes
            you uncomfortable, hurts you,
            or feels like too much in any way,

            I'm genuinely sorry.

        </p>


        <p>

            That was never my intention.

            Everything here comes from a place
            of care, respect and appreciation
            for our friendship.

        </p>


        <p>

            You don't owe me anything.

            I just wanted you to know that

            <strong>
                your friendship means a lot to me.
            </strong>

        </p>


        <p
            style="
            font-family:'Dancing Script';
            font-size:30px;
            color:#ffb8d5;
            ">

            Thank you for being you. ❤️

        </p>

    </div>

</section>


<!-- =======================================================
     FOOTER
======================================================= -->

<footer>

    Made with
    <span>❤️</span>
    for a friendship worth remembering.

    <br><br>

    08 • 09 • 2026

</footer>


<script>

/* =========================================================
   STAR GENERATOR
========================================================= */

const stars =
    document.getElementById("stars");

for(let i = 0; i < 130; i++) {

    const star =
        document.createElement("div");

    star.className = "star";

    star.style.left =
        Math.random() * 100 + "%";

    star.style.top =
        Math.random() * 100 + "%";

    star.style.animationDelay =
        Math.random() * 4 + "s";

    star.style.width =
        (1 + Math.random() * 3) + "px";

    star.style.height =
        star.style.width;

    stars.appendChild(star);
}


/* =========================================================
   PARTICLES
========================================================= */

const particles =
    document.getElementById("particles");

for(let i = 0; i < 35; i++) {

    const p =
        document.createElement("div");

    p.className = "particle";

    p.style.left =
        Math.random() * 100 + "%";

    p.style.animationDuration =
        (8 + Math.random() * 12) + "s";

    p.style.animationDelay =
        Math.random() * 10 + "s";

    p.style.width =
        (2 + Math.random() * 4) + "px";

    p.style.height =
        p.style.width;

    particles.appendChild(p);
}


/* =========================================================
   BIRTHDAY COUNTDOWN
========================================================= */

const birthdayDate =
    new Date(
        "September 8, 2026 00:00:00"
    ).getTime();


function updateCountdown() {

    const now =
        new Date().getTime();

    let distance =
        birthdayDate - now;


    if(distance <= 0) {

        document.getElementById("days")
            .textContent = "00";

        document.getElementById("hours")
            .textContent = "00";

        document.getElementById("minutes")
            .textContent = "00";

        document.getElementById("seconds")
            .textContent = "00";


        document.getElementById("countdownNote")
            .innerHTML =
            "🎂 TODAY IS YOUR DAY, DIYA! ❤️";


        return;

    }


    const days =
        Math.floor(
            distance /
            (1000 * 60 * 60 * 24)
        );


    const hours =
        Math.floor(
            (distance %
                (1000 * 60 * 60 * 24)) /
            (1000 * 60 * 60)
        );


    const minutes =
        Math.floor(
            (distance %
                (1000 * 60 * 60)) /
            (1000 * 60)
        );


    const seconds =
        Math.floor(
            (distance %
                (1000 * 60)) /
            1000
        );


    document.getElementById("days")
        .textContent =
        String(days).padStart(2,"0");


    document.getElementById("hours")
        .textContent =
        String(hours).padStart(2,"0");


    document.getElementById("minutes")
        .textContent =
        String(minutes).padStart(2,"0");


    document.getElementById("seconds")
        .textContent =
        String(seconds).padStart(2,"0");

}


updateCountdown();

setInterval(
    updateCountdown,
    1000
);


/* =========================================================
   TYPING ANIMATION
========================================================= */

const typingMessages = [

    "Some friendships are simply unforgettable. ❤️",

    "And ours is one of those friendships for me. 🫶",

    "No matter what happens, I will always value the memories we made. ✨",

    "I'm genuinely grateful that you became a part of my life. 🌸",

    "And today... I just want to celebrate you. 🎂❤️"

];


let messageIndex = 0;

let characterIndex = 0;

let deleting = false;

const typingText =
    document.getElementById(
        "typingText"
    );


function typeWriter() {

    const current =
        typingMessages[messageIndex];


    if(!deleting) {

        typingText.textContent =
            current.substring(
                0,
                characterIndex + 1
            );

        characterIndex++;


        if(characterIndex >= current.length) {

            deleting = true;

            setTimeout(
                typeWriter,
                2200
            );

            return;

        }

    }

    else {

        typingText.textContent =
            current.substring(
                0,
                characterIndex - 1
            );

        characterIndex--;


        if(characterIndex <= 0) {

            deleting = false;

            messageIndex++;

            if(
                messageIndex >=
                typingMessages.length
            ) {

                messageIndex = 0;

            }

        }

    }


    setTimeout(
        typeWriter,
        deleting ? 30 : 65
    );

}


typeWriter();


/* =========================================================
   FLOATING HEARTS
========================================================= */

function createHeart() {

    const heart =
        document.createElement("div");

    heart.className = "heart";


    const hearts = [

        "❤️",
        "💕",
        "💗",
        "💖",
        "💓",
        "💞",
        "🌸",
        "✨"

    ];


    heart.innerHTML =
        hearts[
            Math.floor(
                Math.random() *
                hearts.length
            )
        ];


    heart.style.left =
        Math.random() * 100 + "vw";


    heart.style.animationDuration =
        (6 + Math.random() * 6) + "s";


    heart.style.fontSize =
        (14 + Math.random() * 20) + "px";


    document.body.appendChild(
        heart
    );


    setTimeout(
        () => heart.remove(),
        13000
    );

}


setInterval(
    createHeart,
    1200
);


/* =========================================================
   FLOATING PETALS
========================================================= */

function createPetal() {

    const petal =
        document.createElement("div");

    petal.className = "petal";

    petal.innerHTML =
        Math.random() > 0.5
        ? "🌸"
        : "✨";


    petal.style.left =
        Math.random() * 100 + "vw";


    petal.style.fontSize =
        (10 + Math.random() * 15) + "px";


    petal.style.animationDuration =
        (7 + Math.random() * 8) + "s";


    document.body.appendChild(
        petal
    );


    setTimeout(
        () => petal.remove(),
        15000
    );

}


setInterval(
    createPetal,
    1700
);


/* =========================================================
   AUDIO ENGINE
   Browser-generated birthday melody
========================================================= */

let audioContext = null;

let masterGain = null;

let musicPlaying = false;

let musicTimer = null;

let noteIndex = 0;


/*
   Simple Happy Birthday-style melody.
   The music is generated locally by Web Audio,
   so no MP3 file is required.
*/

const melody = [

    [264, 0.45],
    [264, 0.45],
    [297, 0.8],
    [264, 0.8],
    [352, 0.8],
    [330, 1.4],

    [264, 0.45],
    [264, 0.45],
    [297, 0.8],
    [264, 0.8],
    [396, 0.8],
    [352, 1.4],

    [264, 0.45],
    [264, 0.45],
    [528, 0.8],
    [440, 0.8],
    [352, 0.8],
    [330, 0.8],
    [297, 1.4],

    [466, 0.45],
    [466, 0.45],
    [440, 0.8],
    [352, 0.8],
    [396, 0.8],
    [352, 1.5]

];


function createAudio() {

    if(!audioContext) {

        audioContext =
            new (
                window.AudioContext ||
                window.webkitAudioContext
            )();


        masterGain =
            audioContext.createGain();

        masterGain.gain.value =
            0.07;

        masterGain.connect(
            audioContext.destination
        );

    }

}


/* =========================================================
   PLAY NOTE
========================================================= */

function playNote(
    frequency,
    duration
) {

    if(!audioContext)
        return;


    const oscillator =
        audioContext.createOscillator();


    const gain =
        audioContext.createGain();


    oscillator.type =
        "sine";


    oscillator.frequency.value =
        frequency;


    oscillator.connect(gain);

    gain.connect(masterGain);


    const now =
        audioContext.currentTime;


    gain.gain.setValueAtTime(
        0,
        now
    );


    gain.gain.linearRampToValueAtTime(
        0.7,
        now + 0.03
    );


    gain.gain.exponentialRampToValueAtTime(
        0.001,
        now + duration
    );


    oscillator.start(now);

    oscillator.stop(
        now + duration + 0.05
    );

}


/* =========================================================
   MUSIC LOOP
========================================================= */

function playMelody() {

    if(!musicPlaying)
        return;


    const note =
        melody[noteIndex];


    playNote(
        note[0],
        note[1]
    );


    noteIndex++;

    if(
        noteIndex >=
        melody.length
    ) {

        noteIndex = 0;

    }


    musicTimer =
        setTimeout(
            playMelody,
            (note[1] * 1000) + 100
        );

}


/* =========================================================
   START MUSIC
========================================================= */

function startMusic() {

    createAudio();


    if(
        audioContext.state ===
        "suspended"
    ) {

        audioContext.resume();

    }


    if(musicPlaying)
        return;


    musicPlaying = true;

    noteIndex = 0;

    playMelody();


    document.getElementById(
        "musicButton"
    ).textContent = "🔊";

}


/* =========================================================
   STOP MUSIC
========================================================= */

function stopMusic() {

    musicPlaying = false;


    clearTimeout(
        musicTimer
    );


    document.getElementById(
        "musicButton"
    ).textContent = "🔇";

}


/* =========================================================
   TOGGLE MUSIC
========================================================= */

function toggleMusic() {

    if(musicPlaying) {

        stopMusic();

    }

    else {

        startMusic();

    }

}


/* =========================================================
   BEGIN CINEMATIC EXPERIENCE
========================================================= */

function beginExperience() {

    startMusic();


    const intro =
        document.getElementById(
            "intro"
        );


    intro.classList.add(
        "hidden"
    );


    setTimeout(
        () => {

            document.querySelector(
                ".hero"
            ).scrollIntoView({
                behavior: "smooth"
            });

        },
        1000
    );


    /*
       Initial heart burst
    */

    for(
        let i = 0;
        i < 25;
        i++
    ) {

        setTimeout(
            createHeart,
            i * 80
        );

    }

}


/* =========================================================
   BIRTHDAY CELEBRATION
========================================================= */

function birthdayCelebration() {

    startMusic();


    /*
       Massive heart explosion
    */

    for(
        let i = 0;
        i < 80;
        i++
    ) {

        setTimeout(
            () => {

                const heart =
                    document.createElement(
                        "div"
                    );

                heart.className =
                    "heart";

                heart.innerHTML =
                    [
                        "❤️",
                        "💕",
                        "💖",
                        "💗",
                        "✨",
                        "🌸"
                    ][
                        Math.floor(
                            Math.random() * 6
                        )
                    ];


                heart.style.left =
                    Math.random() * 100 +
                    "vw";


                heart.style.bottom =
                    Math.random() * 30 +
                    "vh";


                heart.style.animationDuration =
                    (3 +
                    Math.random() * 4) +
                    "s";


                heart.style.fontSize =
                    (18 +
                    Math.random() * 35) +
                    "px";


                document.body.appendChild(
                    heart
                );


                setTimeout(
                    () =>
                        heart.remove(),
                    8000
                );

            },
            i * 35
        );

    }


    /*
       Confetti
    */

    const symbols = [
        "❤️",
        "💗",
        "✨",
        "🌸",
        "🎉",
        "🎀"
    ];


    for(
        let i = 0;
        i < 120;
        i++
    ) {

        setTimeout(
            () => {

                const c =
                    document.createElement(
                        "div"
                    );

                c.className =
                    "confetti";


                c.innerHTML =
                    symbols[
                        Math.floor(
                            Math.random() *
                            symbols.length
                        )
                    ];


                c.style.left =
                    Math.random() * 100 +
                    "vw";


                c.style.top =
                    "-20px";


                c.style.fontSize =
                    (10 +
                    Math.random() * 15) +
                    "px";


                c.style.animationDuration =
                    (3 +
                    Math.random() * 3) +
                    "s";


                document.body.appendChild(
                    c
                );


                setTimeout(
                    () => c.remove(),
                    7000
                );

            },
            i * 25
        );

    }


    /*
       Birthday message
    */

    setTimeout(
        () => {

            alert(
                "🎂 Happy Birthday, Diya! ❤️\n\n" +
                "May this year give you countless reasons to smile. ✨"
            );

        },
        800
    );

}


/* =========================================================
   MIDNIGHT BIRTHDAY DETECTION
========================================================= */

let birthdayCelebrationTriggered =
    false;


function checkBirthdayMoment() {

    const now =
        new Date();


    const isBirthday =
        now.getFullYear() === 2026 &&
        now.getMonth() === 8 &&
        now.getDate() === 8;


    if(
        isBirthday &&
        !birthdayCelebrationTriggered
    ) {

        birthdayCelebrationTriggered =
            true;


        document.getElementById(
            "countdownNote"
        ).innerHTML =
            "🎂 TODAY IS YOUR DAY, DIYA! ❤️";


        setTimeout(
            birthdayCelebration,
            1200
        );

    }

}


setInterval(
    checkBirthdayMoment,
    1000
);


/* =========================================================
   PAGE VISIBILITY
========================================================= */

document.addEventListener(
    "visibilitychange",
    () => {

        if(
            document.hidden &&
            musicPlaying
        ) {

            /*
               Don't completely destroy
               music state.
            */

        }

    }
);


/* =========================================================
   SMOOTH SCROLL REVEAL
========================================================= */

const observer =
    new IntersectionObserver(
        entries => {

            entries.forEach(
                entry => {

                    if(
                        entry.isIntersecting
                    ) {

                        entry.target.style.opacity =
                            "1";

                        entry.target.style.transform =
                            "translateY(0)";

                    }

                }
            );

        },
        {
            threshold: 0.12
        }
    );


document
    .querySelectorAll(
        ".reason, .memory-item, .photo-card, .message-card"
    )
    .forEach(
        element => {

            element.style.opacity =
                "0";

            element.style.transform =
                "translateY(35px)";

            element.style.transition =
                "opacity 1s ease, transform 1s ease";

            observer.observe(
                element
            );

        }
    );


</script>

</body>
</html>
